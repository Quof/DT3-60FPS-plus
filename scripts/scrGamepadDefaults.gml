/*
Default gamepad controls (codes: see scrGamepadInit). Used at startup, by loadOptions as the defaults, and by
"Set to Default" in the GAMEPAD list.
*/
global.gpBind[1]=15   //Left: d-pad left
global.gpBind[2]=16   //Right: d-pad right
global.gpBind[3]=13   //Up: d-pad up
global.gpBind[4]=14   //Down: d-pad down
global.gpBind[5]=1    //Jump: A (Cross)
global.gpBind[6]=3    //Action A: X (Square)
global.gpBind[7]=4    //Action B: Y (Triangle)
global.gpBind[8]=2    //Action C: B (Circle)
global.gpBind[9]=7    //Swap Character: L2
global.gpBind[10]=8   //Swap Ability Set: R2
global.gpBind[11]=0   //(Skip: always BACK)
global.gpBind[12]=0   //(Pause: always START)
global.gpBind[13]=5   //Dash Left: L1
global.gpBind[14]=6   //Dash Right: R1
