//Randomizer: a weapon upgrade's weapon (argument0: oWeaponLevelUpgrade's image_index)
switch (argument0)
{
  case 0: return "Master Sword"
  case 1: return "Bow & Arrow"
  case 2: return "Fuse Bomb"
  case 3: return "Hair Whip"
  case 4: return "Dagger"
  case 5: return "Holy Water"
  case 6: return "X-Buster"
  case 7: return "Shotgun Ice"
  case 8: return "Gravity Well"
  case 9: return "Arm Cannon"
  case 10: return "Missile"
}
return "Morph Bomb"
