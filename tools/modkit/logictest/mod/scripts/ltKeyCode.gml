//Logic Test: a button's number in scrController (argument0: its name), or 0
switch (argument0)
{
  case "left": return 1
  case "right": return 2
  case "up": return 3
  case "down": return 4
  case "jump": return 5
  case "a": return 6
  case "b": return 7
  case "c": return 8
  case "swap": return 9
  case "abil": return 10
  case "skip": return 11
  case "pause": return 12
  case "dashl": return 13
  case "dashr": return 14
  case "confirm": return 15
  case "cancel": return 16
}
return 0
