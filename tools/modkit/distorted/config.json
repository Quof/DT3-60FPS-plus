  "instance_code_rules": [
    {
      "objects": [
        "oBTB_LatchCrystal",
        "oBomberBat",
        "oBomberCloud",
        "oColorZone",
        "oEnergizedTrapSpawner",
        "oG6WindSpot",
        "oHexCircle",
        "oHexFullCircle",
        "oMovingSpikeR_Proper",
        "oMovingTrap",
        "oMovingTrapRed",
        "oStrikePoint_Ext",
        "oVaultFingers",
        "oZapTrapRed",
        "oBlackHexRing",
        "oDBlueHexRing",
        "oDBlueHexTunnel",
        "oDBlueJeremyRing",
        "oDColourZone",
        "oDFollowRing",
        "oDGreenHexRing",
        "oDGreenHexTunnel",
        "oDGreenUDHexRing",
        "oDHexFullRing",
        "oDHexFullRingBlue",
        "oDHexRing",
        "oDHexTunnel",
        "oDPHR",
        "oDWEXring",
        "oDYellowHexRing",
        "oDYellowHexTunnel",
        "oGUDHexTunnel",
        "oWhiteHexRing"
      ],
      "from": "(?<![\\w.])direction(\\s*=)(?!=)",
      "to": "_direction\\1",
      "why": "direction -> _direction (DT3+, and this mod's ports of its new ring objects, move these objects by their own _direction)"
    },
    {
      "objects": [
        "oSwitchBarrier"
      ],
      "from": "(?<![\\w.])switchID\\s*=\\s*\\((\\d+)\\)",
      "to": "switchID=(GID(\\1)); switchCache=\\1",
      "why": "the switch's id kept in switchCache (DT3+'s oSwitchBarrier looks it up again from it)"
    },
    {
      "objects": [
        "oTimeSwBarrier"
      ],
      "from": "(?<![\\w.])switchID\\[(\\w+)\\]\\s*=\\s*\\((\\d+)\\)",
      "to": "switchID[\\1]=(GID(\\2)); switchCache[\\1]=\\2",
      "why": "the switches' ids kept in switchCache (DT3+'s oTimeSwBarrier looks them up again from it)"
    },
    {
      "objects": [
        "oSwitchPanelColor",
        "oSwitchPanelCRev"
      ],
      "from": "(?<![\\w.])targetDoor\\[(\\w+)\\]\\s*=\\s*\\((\\d+)\\)",
      "to": "targetDoor[\\1]=(GID(\\2)); idsForTargetDoors[\\1]=\\2",
      "why": "the doors' ids kept in idsForTargetDoors (DT3+'s switch panels look them up again from it)"
    },
    {
      "objects": [
        "oLockPanelColor"
      ],
      "from": "(?<![\\w.])targetDoor\\s*=\\s*\\((\\d+)\\)",
      "to": "targetDoor=(GID(\\1)); idForTargetDoor=\\1",
      "why": "the door's id kept in idForTargetDoor (DT3+'s oLockPanelColor looks it up again from it)"
    },
    {
      "objects": [
        "oPuzzleReset"
      ],
      "from": "(?<![\\w.])myObj\\[(\\w+)\\]\\s*=\\s*\\((\\d+)\\)",
      "to": "myObj[\\1]=(GID(\\2)); objCache[\\1]=\\2",
      "why": "the ids kept in objCache (DT3+'s oPuzzleReset looks them up again from it)"
    },
    {
      "objects": [
        "oPlatBud"
      ],
      "from": "(?<![\\w.])myWeight\\s*=\\s*\\((\\d+)\\)",
      "to": "myWeight=(GID(\\1)); weightCache=\\1",
      "why": "the weight's id kept in weightCache (DT3+'s oPlatBud looks it up again from it)"
    },
    {
      "objects": [
        "oStepDoorA"
      ],
      "from": "(?<![\\w.])ownerID([12])\\s*=\\s*\\((\\d+)\\)",
      "to": "ownerID\\1=(GID(\\2)); ownerRawID\\1=\\2",
      "why": "the ids kept in ownerRawID1/2 (DT3+'s oStepDoorA looks them up again from them)"
    },
    {
      "objects": [
        "oPlatformString"
      ],
      "from": "(?<![\\w.])stringTo\\[(\\w+)\\]\\s*=\\s*\\((\\d+)\\)",
      "to": "stringTo[\\1]=(GID(\\2)); idsToStringTo[\\1]=\\2",
      "why": "the ids kept in idsToStringTo (DT3+'s oPlatformString looks them up again from it)"
    }
  ],
  "replace_sprites": [
    "sTitleText"
  ],
