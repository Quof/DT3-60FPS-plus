  "patch_rules": {
    "rIntro": {
      "skip": true,
      "why": "the first room, which runs before the mods are loaded: its only change (the window's title) is in the init hook"
    },
    "rBT_HUB": {
      "room_code": "locationCheck(34)\nglobal.mapTeleport=0\nglobal.rbSwitchBlueOn=false\n//SS_SetSoundFreq(global.msc_MarioWorld,22050)\nscrMusicFreq(global.msc_MarioWorld,22050) //remastered music change: scaled to the file's own sample rate (scrMusicFreq)\n\nglobal.currentBoss=\"\"; global.bossTrack=0\nglobal.partySplit=0\nabilSetRemove(0)\n/*\nif global.BTB_ZephSecret=0 //If player finds the secret morph ball room in NZZ's third room\n{\n  tile_layer_hide(1000010)\n}\n\nif global.bossGalleryTime[64]=99999 and global.bossGalleryHitsN[64]=99999 //If player beats WEX\n{\n  tile_layer_hide(1000020)\n}\n*/\nvar tempMplay;\ntempMplay=findMusic(2100) //spsp ns\nplayMusic(tempMplay,0,0)",
      "why_room_code": "Distorted's room code (it shows all of the hub and plays its own music), with DT3+'s music frequency line"
    }
  },
  "spawner_cleanup": {
    "oBallChainControl": "var i;\nfor(i=1;i<=maxChain;i+=1) {with (chain[i]) {instance_change(global.modMarkObj,false)}}\nwith (ball) {instance_change(global.modMarkObj,false)}",
    "oCHAOS_Seeker": "with (myRange) {instance_change(global.modMarkObj,false)}\nwith (myDoorA) {instance_change(global.modMarkObj,false)}\nwith (myDoorB) {instance_change(global.modMarkObj,false)}",
    "oMetRipper": "with (myGrapplePoint) {instance_change(global.modMarkObj,false)}",
    "oEventBarrier": "if variable_local_exists(\"myBikeDestroy\") {with (myBikeDestroy) {instance_change(global.modMarkObj,false)}}",
    "oHammaHammaMain": "with (leftBall) {instance_change(global.modMarkObj,false)}\nwith (rightBall) {instance_change(global.modMarkObj,false)}",
    "oCV_SwordKnight": "with (mySword) {instance_change(global.modMarkObj,false)}",
    "oSpinGuard": "var i;\nfor(i=0;i<2;i+=1) {with (shieldPart[i]) {instance_change(global.modMarkObj,false)}}",
    "oRotatingChainDevice": "var i;\nfor(i=0;i<4;i+=1) {with (myGrapplePoints[i]) {instance_change(global.modMarkObj,false)}}",
    "oSpikePlatformA": "with (spikeTFol) {instance_change(global.modMarkObj,false)}",
    "oCV_PeepingEye": "var i;\nfor(i=0;i<5;i+=1) {with (eyePart[i]) {instance_change(global.modMarkObj,false)}}\nwith (eyeTail) {instance_change(global.modMarkObj,false)}",
    "oFacCamera": "with (myInfectSpot) {instance_change(global.modMarkObj,false)}",
    "oRailChainDevice": "var i;\nfor(i=0;i<5;i+=1) {with (myGrapplePoints[i]) {instance_change(global.modMarkObj,false)}}",
    "oWS_ScrewWarTurret": "with (myCollision) {instance_change(global.modMarkObj,false)}",
    "oPlayerIdle": "with (idleShield) {instance_change(global.modMarkObj,false)}",
    "oGateF_DoorSwitch": "with (myDoor) {instance_change(global.modMarkObj,false)}",
    "oJunkBot": "with (myInfectSpot) {instance_change(global.modMarkObj,false)}",
    "oChaosElevator": "with (myCeiling) {instance_change(global.modMarkObj,false)}\nwith (myLeft) {instance_change(global.modMarkObj,false)}\nwith (myRight) {instance_change(global.modMarkObj,false)}",
    "oJunkyardCar": "with (mySolid) {instance_change(global.modMarkObj,false)}"
  },
  "_about_spawner_cleanup": "a patch takes an instance out without its destroy event (it was never there): what its create event made goes with it, by this code run in it first (the variables it keeps them in)",
  "instance_code": {
    "rBT_HUB 470554": "bShowArrow=true\nexitType=0\nnewMapX=128\nnewMapY=96\ntoRoom=rYellowRide",
    "rBT_HUB 470555": "stringToShow=\"A room with a yellow hex ring that follows you. Neil liked the thing at the end in the previous distorted DLC.\"\nsignSize=3",
    "rBT_HUB 470553": "image_xscale=4\n//if global.bossGalleryTime[64]=99999 {instance_destroy()}",
    "rCCity_NB_S1a 162383": "/*maxDoor=1\ntargetDoor[0]=(162382)\nimage_index=2*/\nmaxDoor=1\ntargetDoor[0]=(GID(161461)); idsForTargetDoors[0]=161461",
    "rGame6_EarthB 320420": "maxResetObj=3\nmyObj[0]=(GID(320208)); objCache[0]=320208\nmyObj[1]=(GID(320209)); objCache[1]=320209\n//myObj[2]=(320210)\nmyObj[2]=(GID(320211)); objCache[2]=320211",
    "rGame6_FireExtra 326242": "maxResetObj=1\nmyObj[0]=(GID(326086)); objCache[0]=326086",
    "rMega4_StormD 218634": "bFollow=0\nimage_angle=180; y-=16",
    "rMega4_StormD 218635": "bFollow=0",
    "rMega4_StormD 218636": "bFollow=0\nimage_angle=180; y-=16",
    "rMountTemple_F 207488": "fanMax=2\nfanID[0]=(GID(207486))\nfanID[1]=(GID(207487))\n//fanID[2]=(207490)\nimage_angle=90"
  },
  "_about_instance_code": "creation code merged by hand (the original's, DT3+'s and Distorted's changed the same lines): Distorted's, with DT3+'s GID() lookups and the ids its objects keep to look them up again",
  "_about_left_out": "Distorted's swap type 4 (Thematic: Link with Belmont, Mega Man with Samus) is left out: DT3+'s own swap type 4, Standard (Fixed), links the sets the same way (scrSwapLinkedSet), and its changes to characterStepEvent and pSwapAbility were only that. DT3+ already has Distorted's Restart Music on Death option (optMLoop), so menuOptions isn't replaced"
}
